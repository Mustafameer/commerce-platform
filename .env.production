# ⚠️ PRODUCTION CONFIGURATION - DO NOT COMMIT THIS FILE
# This is a template showing expected variables
# All values come from Railway environment variables at runtime
# 
# Railway automatically sets:
# - DATABASE_URL (PostgreSQL connection)
# - NODE_ENV=production
# - PORT (default 8080)
# 
# Never commit .env files - use .gitignore

# Frontend domain - must match your Railway deployment URL
VITE_API_URL=https://web-production-9efff.up.railway.app

# ⚠️ DATABASE_URL: Automatically set by Railway PostgreSQL plugin
# DO NOT hardcode this value!
# It will be injected at runtime by Railway
# Format: postgresql://user:password@host:port/database

# Server port (Railway sets this)
PORT=8080

# Environment
NODE_ENV=production
