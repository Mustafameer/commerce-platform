# ====== DATABASE CONFIGURATION ======
# LOCAL ONLY: PostgreSQL on your machine or Docker
# Create a .env file with localhost settings only.
# DO NOT commit .env - it's in .gitignore
DATABASE_URL=postgresql://postgres:123@localhost:5432/multi_ecommerce

# ====== SERVER CONFIGURATION ======
PORT=3000
NODE_ENV=development

# ====== BUILD & FRONTEND ======
# LOCAL: localhost
VITE_API_URL=http://localhost:3000

# ====== EMAIL CONFIGURATION (OPTIONAL) ======
# Using Nodemailer for transactional emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ====== FILE STORAGE ======
# Using local /uploads directory for file storage
UPLOADS_DIR=./uploads

# ====== FIREBASE CONFIGURATION (OPTIONAL) ======
# If you have Firebase credentials, set these to enable Firebase Storage
# Otherwise, images will be saved locally in the /uploads directory
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=

