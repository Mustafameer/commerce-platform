# ====== DATABASE CONFIGURATION ======
# LOCAL DEV: PostgreSQL on your machine or Docker
# DATABASE_URL=postgresql://postgres:password@localhost:5432/commerce_platform
#
# PRODUCTION (Railway): DO NOT set - Railway provides via PostgreSQL plugin
# Create a .env file with localhost for LOCAL development only
# DO NOT commit .env - it's in .gitignore
DATABASE_URL=postgresql://postgres:password@localhost:5432/commerce_platform

# ====== SERVER CONFIGURATION ======
PORT=3000
# LOCAL=development, PRODUCTION=production (Railway sets this)
NODE_ENV=development

# ====== BUILD & FRONTEND ======
# LOCAL: localhost
VITE_API_URL=http://localhost:3000
# PRODUCTION: Railway domain (Railway sets this)
# VITE_API_URL=https://your-app.up.railway.app

# ====== EMAIL CONFIGURATION (OPTIONAL) ======
# Using Nodemailer for transactional emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ====== FILE STORAGE ======
# Using local /uploads directory for file storage
UPLOADS_DIR=./uploads

# ====== FIREBASE CONFIGURATION (OPTIONAL) ======
# If you have Firebase credentials, set these to enable Firebase Storage
# Otherwise, images will be saved locally in the /uploads directory
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=

