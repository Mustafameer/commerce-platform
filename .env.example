# ====== DATABASE CONFIGURATION ======
# Cloud database only.
# Set DATABASE_URL from Railway or your cloud provider.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@gondola.proxy.rlwy.net:42495/railway

# ====== SERVER CONFIGURATION ======
PORT=3000
NODE_ENV=production

# ====== BUILD & FRONTEND ======
VITE_API_URL=https://web-production-9efff.up.railway.app

# ====== EMAIL CONFIGURATION (OPTIONAL) ======
# Using Nodemailer for transactional emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ====== FILE STORAGE ======
# Using local /uploads directory for file storage
UPLOADS_DIR=./uploads

# ====== FIREBASE CONFIGURATION (OPTIONAL) ======
# If you have Firebase credentials, set these to enable Firebase Storage
# Otherwise, images will be saved locally in the /uploads directory
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=

