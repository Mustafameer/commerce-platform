# ====== DATABASE CONFIGURATION ======
# Railway automatically provides DATABASE_URL in production
# For local development, use a local PostgreSQL instance
DATABASE_URL=postgresql://postgres:password@localhost:5432/commerce_platform

# ====== SERVER CONFIGURATION ======
PORT=3000
NODE_ENV=development

# ====== BUILD & FRONTEND ======
VITE_API_URL=http://localhost:3000

# ====== EMAIL CONFIGURATION (OPTIONAL) ======
# Using Nodemailer for transactional emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ====== FIREBASE CONFIGURATION (OPTIONAL - NOT USED IN PRODUCTION) ======
# Firebase is currently not used for new uploads (using Railway storage instead)
# Keep these for compatibility with existing code
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=

